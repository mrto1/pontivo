# Kopieren nach .env.local und ausfüllen. Nie committen.
# Passt zu `docker compose up -d db` (Benutzer postgres, Passwort postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hotel_dev
APP_BASE_URL=http://localhost:3000

# fake = Zahlung wird sofort bestätigt (Entwicklung, M1). stripe = Stripe Connect (M2).
PAYMENT_PROVIDER=fake

# Stripe (Testmodus: sk_test_...). Webhook-Endpoint für "Connected accounts" anlegen:
#   <APP_BASE_URL>/api/webhooks/stripe  →  Signing secret hier eintragen
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET_CONNECT=

# Channex (M3)
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=

# E-Mail. Ohne Token werden E-Mails nur in der Konsole ausgegeben.
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=buchung@example.ch
PLATFORM_ALERT_EMAIL=

# Betreiber der Plattform (erscheint in AGB, Datenschutzerklärung und Fusszeile)
PLATFORM_NAME=Pontivo
PLATFORM_OPERATOR=
PLATFORM_ADDRESS=
PLATFORM_CONTACT_EMAIL=
PLATFORM_PHONE=
# Wird auf der Pontivo-Startseite als Beispiel verlinkt
DEMO_HOTEL_SLUG=demo-gasthof
HOSTING_PROVIDER=

# Automatische Übersetzung der Hotel-Texte (Claude API, platform.claude.com). Leer = Knopf ausgeblendet.
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
TRANSLATIONS_PER_MONTH=50

# Mindestens 32 zufällige Zeichen: openssl rand -base64 32
AUTH_SECRET=bitte-durch-einen-langen-zufaelligen-text-ersetzen-123

# Fotos werden in diesem Ordner gespeichert (Docker: als Volume einbinden)
UPLOAD_DIR=./data/uploads

# Später optional S3-kompatibler Speicher (Region CH/EU)
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
