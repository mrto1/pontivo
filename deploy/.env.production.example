# Kopieren nach deploy/.env.production und ausfüllen. NIE ins Git hochladen.
# Zufällige Werte erzeugen: openssl rand -hex 32   (bzw. -base64 32 für GUEST_DATA_KEY)

# --- Server und Domain
APP_DOMAIN=pontivo.ch
APP_BASE_URL=https://pontivo.ch
ACME_EMAIL=
POSTGRES_PASSWORD=

# --- Sicherheit
AUTH_SECRET=
GUEST_DATA_KEY=

# --- Zahlungen: zuerst mit Stripe-Testschlüsseln (sk_test_…), live erst mit dem ersten Hotel
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
# Öffentlicher Schlüssel pk_… (Konto-Eröffnung direkt im Assistenten)
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET_CONNECT=

# --- E-Mail (Postmark)
POSTMARK_SERVER_TOKEN=
# Postmark-Webhook (Bounces/Spam): <APP_BASE_URL>/api/webhooks/postmark, in Postmark Basic Auth (Benutzer postmark, Passwort = dieser Wert)
POSTMARK_WEBHOOK_SECRET=
# Push-Mitteilungen im Admin: Schlüsselpaar mit "npx web-push generate-vapid-keys" erzeugen (privaten Schlüssel nie weitergeben)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
EMAIL_FROM=buchung@pontivo.ch
PLATFORM_ALERT_EMAIL=

# --- Betreiber (AGB, Datenschutz, Fusszeile)
PLATFORM_NAME=Pontivo
PLATFORM_OPERATOR=
PLATFORM_ADDRESS=
PLATFORM_CONTACT_EMAIL=
PLATFORM_PHONE=
HOSTING_PROVIDER=Infomaniak Network SA, Genf (Schweiz)
DEMO_HOTEL_SLUG=demo-gasthof

# --- Channex (später, zuerst Staging)
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=

# --- Automatische Übersetzung (optional)
ANTHROPIC_API_KEY=
TRANSLATE_MODEL=claude-sonnet-5-5
TRANSLATIONS_PER_MONTH=50
