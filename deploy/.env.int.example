# Testumgebung «int» (int.pontivo.ch). Kopieren nach deploy/.env.int und ausfüllen. NIE ins Git.
# Eigene Datenbank, eigene Geheimnisse, Testschlüssel. Nie Werte aus .env.production übernehmen (ausser Anbieter-Testschlüssel).

ENVIRONMENT_LABEL=int
APP_BASE_URL=https://int.pontivo.ch
POSTGRES_PASSWORD=
AUTH_SECRET=
# Eigener Schlüssel (nie derselbe wie in Produktion)
GUEST_DATA_KEY=

# Zahlungen: NUR Stripe-Testschlüssel (sk_test_… / pk_test_…), eigener Webhook https://int.pontivo.ch/api/webhooks/stripe
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET_CONNECT=
# Ohne Stripe-Testschlüssel: Buchungen ohne Zahlung bestätigen (nur int!)
# PAYMENT_PROVIDER=fake
# ALLOW_FAKE_PAYMENTS=1

# E-Mail: int verschickt keine echten Mails. docker-compose.int.yml setzt SMTP_URL auf den Mail-Fänger Mailpit,
# alle Mails lesen unter https://int.<Domain>/mail (gleiches Passwort wie int). Kein Postmark-Token nötig.
# Nur wenn Mailpit nicht genutzt wird: Postmark-Token setzen, dann gehen alle Mails an MAIL_REDIRECT_TO.
MAIL_REDIRECT_TO=test@pontivo.ch
POSTMARK_SERVER_TOKEN=
EMAIL_FROM=int@pontivo.ch
PLATFORM_ALERT_EMAIL=

# Channex: nur Staging
CHANNEX_BASE_URL=https://staging.channex.io/api/v1
CHANNEX_API_KEY=
CHANNEX_WEBHOOK_SECRET=

# Betreiberangaben wie in Produktion (damit Impressum/AGB-Texte gleich aussehen)
PLATFORM_NAME=Pontivo
PLATFORM_OPERATOR=
PLATFORM_ADDRESS=
PLATFORM_CONTACT_EMAIL=
HOSTING_PROVIDER=Infomaniak Network SA, Genf (Schweiz)
DEMO_HOTEL_SLUG=demo-gasthof

# KI-Funktionen in int besser aus lassen (Kosten); nur zum gezielten Testen einen Schlüssel mit Ausgabenlimit eintragen
ANTHROPIC_API_KEY=
